# ------------------------------------------------------------------ #
# VEYRONIX configuration. Copy to `.env` and edit. Never commit `.env`.
# All variables are prefixed VEYRONIX_ and map to veyronix/core/config.py.
# ------------------------------------------------------------------ #

# Environment: local | docker | ci | prod
VEYRONIX_ENVIRONMENT=local
VEYRONIX_DEBUG=true
VEYRONIX_RANDOM_SEED=42

# --- Storage ---
# Local default is SQLite (zero infra). Docker Compose overrides with Postgres:
# VEYRONIX_DATABASE_URL=postgresql+psycopg://veyronix:veyronix@postgres:5432/veyronix
VEYRONIX_DATABASE_URL=sqlite:///data/veyronix.db
VEYRONIX_DUCKDB_PATH=data/veyronix.duckdb
VEYRONIX_REDIS_URL=redis://localhost:6379/0

# --- Simulator ---
VEYRONIX_SIM_SEED=7
VEYRONIX_SIM_DEFAULT_MINUTES=1440

# --- ML ---
VEYRONIX_PREDICTION_HORIZON_MINUTES=30
VEYRONIX_LOOKBACK_MINUTES=30
VEYRONIX_TRAIN_FRAC=0.6
VEYRONIX_VAL_FRAC=0.2

# --- AI / LLM ---
# provider: offline | anthropic | openai
# "offline" needs NO API keys and runs the deterministic reasoner.
VEYRONIX_LLM_PROVIDER=offline
VEYRONIX_LLM_MODEL=claude-3-5-sonnet-latest
# VEYRONIX_ANTHROPIC_API_KEY=sk-ant-...
# VEYRONIX_OPENAI_API_KEY=sk-...

# --- Agent guardrails ---
VEYRONIX_AGENT_MAX_STEPS=12
VEYRONIX_AGENT_TIMEOUT_SECONDS=90
VEYRONIX_AGENT_MAX_TOOL_CALLS=20
VEYRONIX_AGENT_TOKEN_BUDGET=20000

# --- Remediation safety ---
# Global kill-switch. Keep false unless you explicitly want LOW-risk auto-actions.
VEYRONIX_ALLOW_AUTO_REMEDIATION=false

# --- API ---
VEYRONIX_API_HOST=0.0.0.0
VEYRONIX_API_PORT=8000
